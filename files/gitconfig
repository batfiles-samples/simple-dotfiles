; Installed at ~/.gitconfig, by the directory action covering this folder.
;
; The excludesfile below is the other half of the `gitignore` action, which
; does have to be named: it installs `git/gitignore` as `~/.config/git/ignore`
; -- a different name in a different place, so no directory action reaches it.

[core]
	excludesfile = ~/.config/git/ignore

[init]
	defaultBranch = main

[pull]
	rebase = true

[alias]
	st = status --short
	lg = log --oneline --graph --decorate
